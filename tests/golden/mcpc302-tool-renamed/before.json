            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ],
  "resources": [],
  "prompts": []
}
