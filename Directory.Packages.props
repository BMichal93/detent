<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Every entry below must be justified by an ADR under docs/adr/.
       Dependency count is a security property of this project, not an
       implementation detail. See CLAUDE.md. -->
  <ItemGroup Label="Runtime - see docs/adr/0002-tech-stack.md">
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <!-- Contract files only (Detent.Formats), per ADR-0002. Never referenced
         from Detent.Core: contracts are parsed at the I/O boundary into the
         plain data model Core actually consumes. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="Test - see docs/adr/0002-tech-stack.md">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
